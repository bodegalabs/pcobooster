{
  "name": "worship-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/ --path=/local -- next dev --hostname 127.0.0.1",
    "dev:present": "infisical run --env=dev --path=/ --path=/local -- env PRESENTATION_MODE=1 next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "bun run check",
    "lint:fix": "bun run fix",
    "lint:ci": "bun run check --format github",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "infisical run --env=dev --path=/ -- bunx auth@1.7.5 generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "infisical run --env=dev --path=/ -- drizzle-kit migrate",
    "db:push": "infisical run --env=dev --path=/ -- drizzle-kit push",
    "db:studio": "infisical run --env=dev --path=/ -- drizzle-kit studio",
    "db:seed": "infisical run --env=dev --path=/ -- bun run scripts/seed.ts",
    "db:backfill:planning-center-identities": "infisical run --env=dev --path=/ -- bun run scripts/backfill-planning-center-identities.ts",
    "check": "ultracite check --max-warnings 0",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flags-sdk/vercel": "^1.4.8",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.103.1",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "flags": "^4.3.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.12.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
