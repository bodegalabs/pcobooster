{
  "name": "pcobooster",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/ --path=/local -- turbo run dev",
    "dev:present": "infisical run --env=dev --path=/ --path=/local -- env PRESENTATION_MODE=1 turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@pcobooster/web...",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run check",
    "lint:fix": "bun run fix",
    "lint:ci": "bun run check --format github",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "test": "turbo run test //#test:root",
    "test:root": "vitest run lint scripts",
    "test:watch": "vitest",
    "auth:generate": "infisical run --env=dev --path=/ -- turbo run auth:generate --filter=@pcobooster/api",
    "db:generate": "turbo run db:generate --filter=@pcobooster/api",
    "db:migrate": "infisical run --env=dev --path=/ -- turbo run db:migrate --filter=@pcobooster/api",
    "db:push": "infisical run --env=dev --path=/ -- turbo run db:push --filter=@pcobooster/api",
    "db:studio": "infisical run --env=dev --path=/ -- turbo run db:studio --filter=@pcobooster/api",
    "db:seed": "infisical run --env=dev --path=/ -- bun run scripts/seed.ts",
    "pc:check-contracts": "infisical run --env=dev --path=/ --path=/local -- bun scripts/check-pc-contracts.ts",
    "db:backfill:planning-center-identities": "infisical run --env=dev --path=/ -- bun run scripts/backfill-planning-center-identities.ts",
    "check": "ultracite check --max-warnings 0",
    "fix": "ultracite fix",
    "prepare": "bun run scripts/install-git-hooks.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci": "bun run check && bun run typecheck && bun run test",
    "proof": "bun run scripts/verification/proof.ts",
    "verification:create": "bun run scripts/verification/create-verification-skill.ts",
    "dev:web": "infisical run --env=dev --path=/ --path=/local -- turbo run dev --filter=@pcobooster/web",
    "dev:server": "infisical run --env=dev --path=/ --path=/local -- turbo run dev --filter=@pcobooster/server",
    "dev:marketing": "turbo run dev --filter=@pcobooster/marketing",
    "dev:admin": "turbo run dev --filter=@pcobooster/admin",
    "build:admin": "turbo run build --filter=@pcobooster/admin...",
    "build:marketing": "turbo run build --filter=@pcobooster/marketing && bun run scripts/stage-marketing.ts",
    "cloud:session:setup": "bash scripts/codex-cloud/with-infisical.sh bash scripts/codex-cloud/session-setup.sh",
    "cloud:session:status": "bash scripts/codex-cloud/with-infisical.sh bash scripts/codex-cloud/session-status.sh",
    "cloud:session:teardown": "bash scripts/codex-cloud/with-infisical.sh bash scripts/codex-cloud/session-teardown.sh",
    "cloud:session:prune": "bash scripts/codex-cloud/with-infisical.sh bash scripts/codex-cloud/session-prune.sh",
    "cloud:run": "bash scripts/codex-cloud/with-infisical.sh",
    "cloud:dev": "bash scripts/codex-cloud/with-infisical.sh turbo run dev",
    "cloud:build": "bash scripts/codex-cloud/with-infisical.sh turbo run build",
    "cloud:db:migrate": "bash scripts/codex-cloud/with-infisical.sh bun run scripts/codex-cloud/migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.103.1",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pcobooster/api": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "@shadcn/lint": "^0.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2002",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.12.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
