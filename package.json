{
  "name": "pcobooster",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/ --path=/local -- bun run scripts/cloudflare/dev.ts",
    "dev:present": "infisical run --env=dev --path=/ --path=/local -- env PRESENTATION_MODE=1 bun run scripts/cloudflare/dev.ts",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@pcobooster/web...",
    "start": "bun run dev",
    "lint": "bun run check",
    "lint:fix": "bun run fix",
    "lint:ci": "bun run check --format github",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "test": "turbo run test //#test:root",
    "test:root": "vitest run lint scripts",
    "test:watch": "vitest",
    "db:generate": "turbo run db:generate --filter=@pcobooster/api",
    "pc:check-contracts": "infisical run --env=dev --path=/ --path=/local -- bun scripts/check-pc-contracts.ts",
    "check": "ultracite check --max-warnings 0",
    "fix": "ultracite fix",
    "prepare": "bun run scripts/install-git-hooks.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci": "bun run check && bun run typecheck && bun run test",
    "proof": "bun run scripts/verification/proof.ts",
    "verification:create": "bun run scripts/verification/create-verification-skill.ts",
    "dev:marketing": "turbo run dev --filter=@pcobooster/marketing",
    "build:admin": "turbo run build --filter=@pcobooster/admin...",
    "build:marketing": "turbo run build --filter=@pcobooster/marketing && bun run scripts/stage-marketing.ts",
    "cloud:run": "bash scripts/codex-cloud/with-infisical.sh",
    "cloud:dev": "bash scripts/codex-cloud/with-infisical.sh bun run scripts/cloudflare/dev.ts",
    "cloud:build": "bash scripts/codex-cloud/with-infisical.sh bun run build",
    "deploy": "bun alchemy deploy --no-input",
    "deploy:production": "infisical run --env=prod --path=/ --projectId=2eca20e1-20ac-4f06-a086-99ea5c590483 -- env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID bun alchemy deploy --stage prod",
    "infra:plan": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID GITHUB_TOKEN=\"$(gh auth token)\" INFISICAL_API_TOKEN=\"$(infisical user get token --plain)\" bun alchemy deploy alchemy.ci.ts --stage ci --dry-run --detect-drift --no-input",
    "infra:deploy": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID GITHUB_TOKEN=\"$(gh auth token)\" INFISICAL_API_TOKEN=\"$(infisical user get token --plain)\" bun alchemy deploy alchemy.ci.ts --stage ci",
    "db:rehearse": "infisical run --env=prod --path=/ -- bun run scripts/database/migrate-from-postgres.ts --local",
    "alchemy": "node --import ./node_modules/alchemy/bin/register-oxc.js ./node_modules/alchemy/bin/alchemy.js",
    "build:cloudflare": "bun run --cwd apps/web build:cloudflare && bun run --cwd apps/admin build:cloudflare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.103.1",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.79",
    "@cloudflare/workers-types": "5.20260923.1",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@opennextjs/cloudflare": "1.20.6",
    "@pcobooster/api": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "@shadcn/lint": "^0.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alchemy": "2.0.0-beta.79",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-rc.117",
    "lefthook": "^2.1.14",
    "miniflare": "5.20260921.0-alpha",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2002",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "vitest": "^5.0.1",
    "wrangler": "4.137.0"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.3.9",
  "patchedDependencies": {
    "better-auth@1.7.5": "patches/better-auth@1.7.5.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
