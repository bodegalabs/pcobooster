{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "@pcobooster/marketing#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      "env": ["NEXT_PUBLIC_POSTHOG_KEY"]
    },
    "@pcobooster/admin#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "ADMIN_BASE_PATH"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@pcobooster/server#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@pcobooster/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "DEV_AUTH_BYPASS",
        "NEXT_PUBLIC_PLANNING_CENTER_TIME_ZONE",
        "NODE_ENV",
        "PEOPLE_PAGE_ENABLED",
        "PRESENTATION_MODE",
        "PRESENTATION_SEED",
        "NEXT_PUBLIC_POSTHOG_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/stage-marketing.ts"],
      "outputs": [".next/**", "!.next/cache/**", "public/marketing/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": []
    },
    "//#lint:ci": {
      "outputs": []
    },
    "//#test:root": {
      "inputs": ["lint/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "lint/**/*.ts",
        "scripts/**/*.ts",
        "tsconfig.json",
        "vitest.config.ts",
        "packages/config/tsconfig.base.json",
        "alchemy.run.ts"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "passThroughEnv": [
        "AUTH_COOKIE_DOMAIN",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "DEMO_ACCESS_KEY",
        "DEMO_PLANNING_CENTER_CLIENT",
        "DEMO_PLANNING_CENTER_PAT",
        "DEV_AUTH_BYPASS",
        "LOG_LEVEL",
        "LOG_PLANNING_CENTER_TIMINGS",
        "NEXT_PUBLIC_PLANNING_CENTER_TIME_ZONE",
        "NODE_ENV",
        "PEOPLE_PAGE_ENABLED",
        "PLANNING_CENTER_CLIENT",
        "PLANNING_CENTER_OAUTH_CLIENT_ID",
        "PLANNING_CENTER_OAUTH_CLIENT_SECRET",
        "PLANNING_CENTER_PAT",
        "PLANNING_CENTER_TIME_ZONE",
        "PRESENTATION_MODE",
        "PRESENTATION_SEED",
        "PCOBOOSTER_ADMIN_EMAILS",
        "NEXT_PUBLIC_POSTHOG_KEY"
      ],
      "persistent": true
    },
    "db:generate": {
      "cache": false
    }
  }
}
