{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@pcobooster/marketing#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "env": ["POSTHOG_PROJECT_KEY"]
    },
    "@pcobooster/admin#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "ADMIN_BASE_PATH"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@pcobooster/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "PEOPLE_PAGE_ENABLED",
        "PLANNING_CENTER_TIME_ZONE",
        "POSTHOG_PROJECT_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/stage-marketing.ts"],
      "outputs": ["dist/**", "public/marketing/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": []
    },
    "//#lint:ci": {
      "outputs": []
    },
    "//#test:root": {
      "inputs": [
        "lint/**/*.ts",
        "scripts/**/*.ts",
        "scripts/**/*.json",
        "vitest.config.ts",
        "packages/analytics/src/reports.ts",
        "packages/analytics/src/privacy.ts"
      ],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "lint/**/*.ts",
        "scripts/**/*.ts",
        "tsconfig.json",
        "vitest.config.ts",
        "packages/config/tsconfig.base.json",
        "alchemy.run.ts",
        "alchemy.cleanup.ts",
        "alchemy.ci.ts",
        "alchemy.posthog.ts",
        "packages/analytics/src/reports.ts",
        "packages/analytics/src/privacy.ts"
      ],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
