# App origin. Must match where you run the app.
BETTER_AUTH_URL=http://localhost:3000

# Browser origin allowed to call the local Hono service directly.
CORS_ORIGIN=http://localhost:3001

# Generate a long random value.
BETTER_AUTH_SECRET=

# Postgres connection string. For a remote TLS database, use sslmode=verify-full
# to explicitly verify its certificate and hostname with node-postgres.
DATABASE_URL=

# Comma-separated emails that can open /admin.
WORSHIP_ADMIN_ADMIN_EMAILS=

# Planning Center OAuth app credentials.
# Callback URL to register in Planning Center:
# http://localhost:3000/api/auth/callback/planning-center
PLANNING_CENTER_OAUTH_CLIENT_ID=
PLANNING_CENTER_OAUTH_CLIENT_SECRET=

# Optional override if Planning Center org time_zone cannot be read (fallback only).
# The app normally loads timezone from GET /services/v2 (Services Organization).
# NEXT_PUBLIC_ is used only for the brief client loading state before /api/planning-center/organization returns.
# PLANNING_CENTER_TIME_ZONE=America/Los_Angeles
# NEXT_PUBLIC_PLANNING_CENTER_TIME_ZONE=America/Los_Angeles

# Local-only auth shortcut. When set to "1", the server returns a synthesized session
# and uses the PLANNING_CENTER_CLIENT/PLANNING_CENTER_PAT Basic-auth fallback for
# Planning Center API calls. Ignored when NODE_ENV=production.
# DEV_AUTH_BYPASS=1

# Local presentation masking (or run `bun run dev:present`). Requires development
# and is ignored on Vercel. Restart the server and reload open tabs when changing.
# PRESENTATION_MODE=1
# Optional stable seed for a different set of fictional person names.
# PRESENTATION_SEED=my-local-demo
