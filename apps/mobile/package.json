{
  "name": "@pcobooster/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "dev": "expo start --port $(bash scripts/metro-port.sh)",
    "ios": "expo run:ios",
    "native:generate": "expo prebuild --no-install --platform ios",
    "tokens": "bun run scripts/generate-tokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/mobile/src",
    "ios:build": "bash scripts/build-ios.sh",
    "ios:release": "bash scripts/release-ios.sh",
    "ios:release:status": "bun run scripts/release/release-cli.ts status --build",
    "ios:hermes-gate": "bun run scripts/hermes-gate/gate.ts",
    "ios:capture": "bash scripts/capture.sh",
    "ios:compare": "bash scripts/compare.sh",
    "ios:taps": "bash scripts/tap-flows.sh",
    "ios:taps:plan": "bash scripts/tap-flows.sh --suite plan --simulator pcob-expo-runsheet"
  },
  "dependencies": {
    "@expo/ui": "57.0.21",
    "@pcobooster/client": "workspace:*",
    "@pcobooster/contracts": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "5.103.1",
    "core-js": "3.50.0",
    "effect": "4.0.0-rc.117",
    "expo": "57.0.26",
    "expo-application": "57.0.3",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.20.13",
    "@pcobooster/config": "workspace:*",
    "@types/react": "19.2.14",
    "sf-symbols-typescript": "2.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
