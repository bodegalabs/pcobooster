{
  "name": "@pcobooster/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./entry.ts",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform ios --platform android",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --no-install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/mobile/src",
    "release:ios": "bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@pcobooster/client": "workspace:*",
    "@pcobooster/contracts": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "7.5.0",
    "@tanstack/react-query": "5.104.1",
    "core-js": "3.50.0",
    "effect": "4.0.1",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "57.0.13",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
