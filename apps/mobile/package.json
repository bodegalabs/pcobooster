{
  "name": "@pcobooster/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "native:generate": "expo prebuild --no-install --platform ios",
    "tokens": "bun run scripts/generate-tokens.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/mobile/src",
    "ios:build": "bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@expo/ui": "57.0.21",
    "@pcobooster/client": "workspace:*",
    "@pcobooster/contracts": "workspace:*",
    "@pcobooster/planning-center-models": "workspace:*",
    "effect": "4.0.0-rc.117",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@pcobooster/config": "workspace:*",
    "@types/react": "19.2.14",
    "sf-symbols-typescript": "2.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
