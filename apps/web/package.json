{
  "name": "@pcobooster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "bun run ../../scripts/stage-marketing.ts && if [ -n \"$VERCEL\" ]; then next build; else next build --webpack; fi",
    "start": "next start --port 3001",
    "test": "vitest run --root ../.. apps/web/src",
    "check-types": "next typegen && tsc --noEmit",
    "typecheck": "bun run check-types"
  },
  "dependencies": {
